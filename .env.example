# Copy this file to `.env` and fill in your API keys.
# They are read at build time via `--dart-define-from-file=.env` (never committed).
#
# The Movie Database (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# Trakt.tv (https://trakt.tv/oauth/applications) — OAuth device flow
TRAKT_CLIENT_ID=your_trakt_client_id_here
TRAKT_CLIENT_SECRET=your_trakt_client_secret_here

# SIMKL (https://simkl.com/settings/developer/) — free unlimited tracking, Trakt alternative
# Create an app -> copy Client ID (and Secret if shown). Only ID is required for most calls.
SIMKL_CLIENT_ID=your_simkl_client_id_here
SIMKL_CLIENT_SECRET=your_simkl_client_secret_here

# OpenSubtitles (https://www.opensubtitles.com/en/api) — REST api.opensubtitles.com
# Anonymous = 5/day/IP, free login = 20/day (VIP more). One developer Api-Key for the app.
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key_here
